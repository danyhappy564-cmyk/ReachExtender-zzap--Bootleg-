<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, matching SPT 4.1 client plugins. This was net471. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ReachExtender</RootNamespace>
    <AssemblyName>ReachExtender</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.4.0</Version>
    <Company>Mattdokn</Company>
    <Product>ReachExtender</Product>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    References come from a real SPT install, not from the repository's References\
    folder. Those vendored DLLs were 4.0 copies, so building against them produced a
    plugin compiled for types 4.1 no longer has - and it would have kept doing so
    silently, since a 4.0 Assembly-CSharp resolves every name in this project quite
    happily.
  -->
  <PropertyGroup>
    <SptRoot Condition=" '$(SptRoot)' == '' ">E:\SPT 4.1</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptBepInEx>$(SptRoot)\BepInEx</SptBepInEx>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInEx)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInEx)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInEx)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SptManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SptManaged)\Assembly-CSharp.dll')"
           Text="SptRoot '$(SptRoot)' does not look like an SPT install (missing EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll). Pass -p:SptRoot=... or set the SptRoot environment variable." />
  </Target>

  <Target Name="CopyToSPT" AfterTargets="Build" Condition="Exists('$(SptRoot)')">
    <MakeDir Directories="$(SptBepInEx)\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptBepInEx)\plugins" />
  </Target>

  <!--
    The zip is written OUTSIDE the tree being zipped. ZipDirectory archives the
    contents of SourceDirectory, so staging one level down is what keeps the task from
    reading the archive it is writing.
  -->
  <PropertyGroup>
    <ReleaseDir>$(ProjectDir)..\Release</ReleaseDir>
    <ReleaseStagingDir>$(ReleaseDir)\staging</ReleaseStagingDir>
  </PropertyGroup>

  <Target Name="PackageRelease" AfterTargets="CopyToSPT">
    <RemoveDir Directories="$(ReleaseStagingDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseStagingDir)\BepInEx\plugins" />
    <ZipDirectory SourceDirectory="$(ReleaseStagingDir)"
                  DestinationFile="$(ReleaseDir)\ReachExtender.zip"
                  Overwrite="true" />
    <Message Text="Release zip: $(ReleaseDir)\ReachExtender.zip" Importance="high" />
  </Target>

</Project>
